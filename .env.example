# Copy to .env.local for local development. Never commit .env.local.
# On Vercel, add these in Project -> Settings -> Environment Variables.

# Resend API key (https://resend.com/api-keys)
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx

# Where contact-form messages are delivered
CONTACT_EMAIL=info@joydash.me

# OPTIONAL: sender address. Must be on a domain verified in Resend
# (e.g. after verifying joydash.me). If omitted, the Resend test sender is used,
# which can only deliver to the email address that owns your Resend account.
# CONTACT_FROM="Portfolio Contact <contact@joydash.me>"

# ---------------------------------------------------------------------------
# Projects / Blog / Admin (Supabase)  — see docs/ADMIN_SETUP.md
# ---------------------------------------------------------------------------
# Supabase -> Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# SERVER ONLY. Bypasses RLS. Never prefix with NEXT_PUBLIC_ and never commit it.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# The ONLY email allowed into /admin. Must match the user you create in Supabase Auth
# AND the email inside is_admin() in supabase/migrations/0001_projects_blogs.sql
NEXT_PUBLIC_ADMIN_EMAIL=info@joydash.me

# Random string (e.g. `openssl rand -hex 32`). Vercel Cron sends it automatically as
# "Authorization: Bearer <CRON_SECRET>" to /api/sync-blogs.
CRON_SECRET=change-me-to-a-long-random-string
