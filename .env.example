# Copy to .env.local for local development. Never commit .env.local.
# On Vercel, add these in Project -> Settings -> Environment Variables.

# Resend API key (https://resend.com/api-keys)
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx

# Where contact-form messages are delivered
CONTACT_EMAIL=info@joydash.me

# OPTIONAL: sender address. Must be on a domain verified in Resend
# (e.g. after verifying joydash.me). If omitted, the Resend test sender is used,
# which can only deliver to the email address that owns your Resend account.
# CONTACT_FROM="Portfolio Contact <contact@joydash.me>"
